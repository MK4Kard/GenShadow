<Page x:Class="GenShadow_UI.Pages.ShadowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GenShadow_UI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="950"
      Title="ShadowPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Grid.Column="0" Grid.Row="1" Content="Загрузить" Click="Button_Click"
                Margin="10"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="10">
            <Button Content="Рендер" HorizontalAlignment="Left"
                    Padding="10 5" Margin="0 0 0 5"/>
            <ListView Margin="0 5" Height="200">

            </ListView>
            <StackPanel Orientation="Horizontal">
                <Button Content="+"/>
                <Slider/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="[-]"/>
                <Slider/>
            </StackPanel>
            <Slider/>
            <Menu>
                <MenuItem Header="Экспорт">
                    <MenuItem Header="функция1"/>
                    <MenuItem Header="функция2"/>
                    <MenuItem Header="функция3"/>
                    <MenuItem Header="функция4"/>
                </MenuItem>
            </Menu>
        </StackPanel>
    </Grid>
</Page>
